# ---- 数据与产物：体积大、可再生产，不进版本库 ----
# 数据库（几百 MB，且每台电脑各跑各的；用 21-打包数据库 在两台机器之间搬）
data/*.db
data/*.db.bak-*
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 打包出来的数据库压缩包
备份/*.zip

# 回测与换手率研究的结构化结果：每次跑都会重新生成，markdown 报告才是留档的那一份
回测/回测结果-*.json
回测/换手率结果-*.json

# 推送 token 与推送状态：本地秘密 / 运行状态，不进版本库
data/*.token
data/last-push.txt

# 运行日志
logs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 编辑器与系统 ----
.vscode/*.local.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
